{
  "name": "onedev-browser",
  "displayName": "oneDev Browser",
  "description": "Browse issues, PRs, and builds on oneDev repositories",
  "version": "0.0.7",
  "repository": "https://github.com/BingHanLin/vscode-oneDev-browser",
  "icon": "images/icon.png",
  "main": "./dist/extension.js",
  "publisher": "binghanlin",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "onedevSidebar",
          "title": "oneDev",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "onedevSidebar": [
        {
          "id": "onedevPRsView",
          "name": "Pull Requests",
          "icon": "images/icon.png"
        },
        {
          "id": "onedevIssuesView",
          "name": "Issues",
          "icon": "images/icon.png"
        },
        {
          "id": "onedevBuildsView",
          "name": "Builds",
          "icon": "images/icon.png"
        }
      ]
    },
    "configuration": {
      "title": "oneDev Browser",
      "properties": {
        "onedev-browser.url": {
          "type": "string",
          "default": "",
          "description": "URL of your oneDev instance"
        },
        "onedev-browser.email": {
          "type": "string",
          "default": "",
          "description": "Your oneDev account email"
        },
        "onedev-browser.token": {
          "type": "string",
          "default": "",
          "description": "Your oneDev API token"
        },
        "onedev-browser.projectPath": {
          "type": "string",
          "default": "",
          "description": "Your oneDev project path"
        },
        "onedev-browser.maxPRItems": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of Pull Requests to show in the tree view. User setting has highest priority."
        },
        "onedev-browser.maxIssueItems": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of Issues to show in the tree view. User setting has highest priority."
        },
        "onedev-browser.maxBuildItems": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of Builds to show in the tree view. User setting has highest priority."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "onedev-browser.refreshAllViews",
          "when": "view == onedevPRsView || view == onedevIssuesView || view == onedevBuildsView",
          "group": "navigation@1",
          "icon": "$(refresh)",
          "tooltip": "Refresh"
        }
      ]
    },
    "commands": [
      {
        "command": "onedev-browser.openWebview",
        "title": "Open oneDev Webview"
      },
      {
        "command": "onedev-browser.openWebviewToIssue",
        "title": "Open Issue in Webview"
      },
      {
        "command": "onedev-browser.openWebviewToBuild",
        "title": "Open Build in Webview"
      },
      {
        "command": "onedev-browser.refreshAllViews",
        "title": "Refresh"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/node-fetch": "^2.6.11",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4"
  },
  "license": "MIT",
  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}