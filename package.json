{
  "name": "onedev-browser",
  "displayName": "oneDev Browser",
  "description": "Browse issues, PRs, and builds on oneDev repositories",
  "version": "0.2.0",
  "repository": "https://github.com/BingHanLin/vscode-oneDev-browser",
  "icon": "images/icon.png",
  "main": "./dist/extension.js",
  "publisher": "binghanlin",
  "engines": {
    "vscode": "^1.93.0"
  },
  "keywords": [
    "onedev",
    "pull request",
    "issue tracker",
    "code review",
    "ai",
    "git",
    "scm"
  ],
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "onedevSidebar",
          "title": "oneDev",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "onedevSidebar": [
        {
          "id": "onedevPRsView",
          "name": "Pull Requests",
          "icon": "images/icon.png"
        },
        {
          "id": "onedevIssuesView",
          "name": "Issues",
          "icon": "images/icon.png"
        },
        {
          "id": "onedevBuildsView",
          "name": "Builds",
          "icon": "images/icon.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "onedevPRsView",
        "contents": "No OneDev connection configured.\n\nSet up your OneDev server URL, credentials, and project to get started.\n\n[Set Up OneDev Connection](command:onedev-browser.setupWizard)\n\nOr configure manually in [Settings](command:workbench.action.openSettings?%5B%22onedev-browser%22%5D).",
        "when": "onedev-browser.needsSetup"
      },
      {
        "view": "onedevIssuesView",
        "contents": "No OneDev connection configured.\n\n[Set Up OneDev Connection](command:onedev-browser.setupWizard)",
        "when": "onedev-browser.needsSetup"
      },
      {
        "view": "onedevBuildsView",
        "contents": "No OneDev connection configured.\n\n[Set Up OneDev Connection](command:onedev-browser.setupWizard)",
        "when": "onedev-browser.needsSetup"
      }
    ],
    "configuration": {
      "title": "oneDev Browser",
      "properties": {
        "onedev-browser.url": {
          "type": "string",
          "default": "",
          "description": "URL of your oneDev instance"
        },
        "onedev-browser.email": {
          "type": "string",
          "default": "",
          "description": "Your oneDev account email"
        },
"onedev-browser.projectPath": {
          "type": "string",
          "default": "",
          "description": "Your oneDev project path"
        },
        "onedev-browser.maxPRItems": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of Pull Requests to show in the tree view. User setting has highest priority."
        },
        "onedev-browser.maxIssueItems": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of Issues to show in the tree view. User setting has highest priority."
        },
        "onedev-browser.maxBuildItems": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of Builds to show in the tree view. User setting has highest priority."
        },
        "onedev-browser.codeReviewModel": {
          "type": "string",
          "default": "",
          "description": "Specific Language Model family or ID to use for Code Reviews. Use the 'OneDev: Select Code Review Model' command to select from available models."
        },
        "onedev-browser.codeReviewPrompt": {
          "type": "string",
          "default": "",
          "description": "Custom instruction prompt for Code Reviews. If empty, uses the default system prompt.",
          "editPresentation": "multiline"
        },
        "onedev-browser.requestTimeout": {
          "type": "number",
          "default": 30000,
          "description": "Timeout in milliseconds for OneDev API requests (default: 30000)"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "onedev-browser.refreshAllViews",
          "when": "view == onedevPRsView || view == onedevIssuesView || view == onedevBuildsView",
          "group": "navigation@1",
          "icon": "$(refresh)",
          "tooltip": "Refresh"
        }
      ],
      "view/item/context": [
        {
          "command": "onedev-browser.pr.openInBrowser",
          "when": "viewItem == prItem",
          "group": "navigation@1"
        },
        {
          "command": "onedev-browser.pr.checkoutBranch",
          "when": "viewItem == prItem",
          "group": "navigation@2"
        },
        {
          "command": "onedev-browser.pr.aiReview",
          "when": "viewItem == prItem",
          "group": "navigation@3"
        },
        {
          "command": "onedev-browser.pr.copyUrl",
          "when": "viewItem == prItem",
          "group": "cutcopypaste@1"
        },
        {
          "command": "onedev-browser.issue.openInBrowser",
          "when": "viewItem == issueItem",
          "group": "navigation@1"
        },
        {
          "command": "onedev-browser.issue.copyUrl",
          "when": "viewItem == issueItem",
          "group": "cutcopypaste@1"
        },
        {
          "command": "onedev-browser.build.openInBrowser",
          "when": "viewItem == buildItem",
          "group": "navigation@1"
        },
        {
          "command": "onedev-browser.build.copyUrl",
          "when": "viewItem == buildItem",
          "group": "cutcopypaste@1"
        }
      ]
    },
    "commands": [
      {
        "command": "onedev-browser.selectCodeReviewModel",
        "title": "OneDev: Select Code Review Model"
      },
      {
        "command": "onedev-browser.openWebview",
        "title": "Open oneDev Webview"
      },
      {
        "command": "onedev-browser.openWebviewToIssue",
        "title": "Open Issue in Webview"
      },
      {
        "command": "onedev-browser.openWebviewToBuild",
        "title": "Open Build in Webview"
      },
      {
        "command": "onedev-browser.refreshAllViews",
        "title": "Refresh"
      },
      {
        "command": "onedev-browser.triggerChatReview",
        "title": "OneDev: Trigger Chat Review"
      },
      {
        "command": "onedev-browser.checkoutBranch",
        "title": "OneDev: Checkout Branch"
      },
      {
        "command": "onedev-browser.openLocalFile",
        "title": "OneDev: Open Local File"
      },
      {
        "command": "onedev-browser.setToken",
        "title": "OneDev: Set API Token"
      },
      {
        "command": "onedev-browser.setupWizard",
        "title": "OneDev: Set Up Connection"
      },
      {
        "command": "onedev-browser.pr.openInBrowser",
        "title": "Open in Browser",
        "icon": "$(globe)"
      },
      {
        "command": "onedev-browser.pr.checkoutBranch",
        "title": "Checkout Branch",
        "icon": "$(source-control)"
      },
      {
        "command": "onedev-browser.pr.aiReview",
        "title": "AI Code Review",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "onedev-browser.pr.copyUrl",
        "title": "Copy URL",
        "icon": "$(link)"
      },
      {
        "command": "onedev-browser.issue.openInBrowser",
        "title": "Open in Browser",
        "icon": "$(globe)"
      },
      {
        "command": "onedev-browser.issue.copyUrl",
        "title": "Copy URL",
        "icon": "$(link)"
      },
      {
        "command": "onedev-browser.build.openInBrowser",
        "title": "Open in Browser",
        "icon": "$(globe)"
      },
      {
        "command": "onedev-browser.build.copyUrl",
        "title": "Copy URL",
        "icon": "$(link)"
      }
    ],
    "chatParticipants": [
      {
        "id": "onedev-browser.chatParticipant",
        "name": "onedev",
        "description": "Interact with OneDev issues, PRs, and builds.",
        "isSticky": true,
        "commands": [
          {
            "name": "review",
            "description": "Review pull request changes"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/node-fetch": "^2.6.11",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^8.57.0",
    "sinon": "^21.0.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4"
  },
  "license": "MIT",
  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}
